# Copy to a real env file (gitignored):
#   cp .env.example .env
#
# === Database (pick ONE style) ===
#
# Local Docker Compose maps Postgres to host port 5433 (see compose.yaml):
DATABASE_URL=postgresql://axon:axon123@127.0.0.1:5433/axon_db
#
# Or native Postgres on default port:
# DATABASE_URL=postgresql://axon:axon123@127.0.0.1:5432/axon_db
#
# Or Supabase / pooler — set DB_* (takes priority over DATABASE_URL; ssl required):
# DB_USER=postgres.your_project_ref
# DB_PASSWORD=your_password
# DB_HOST=aws-0-us-east-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres

# === Required ===
# Groq: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Shared with SvelteKit proxy — must match fronted AXON_INTERNAL_SECRET
# Generate: openssl rand -base64 32
AXON_INTERNAL_SECRET=replace-with-shared-secret-matching-frontend

# === Optional ===
# Admin dashboard (/admin) allow-list — comma-separated Better-Auth user IDs that
# may read /admin/stats. Set the SAME value on the frontend. Leave empty to keep
# the admin dashboard locked. Open /admin while logged in to see your user ID.
# AXON_ADMIN_USER_IDS=your-better-auth-user-id

# GitHub API (higher rate limits): https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your_token_here
# GITHUB_AUTH_STYLE=token

INGEST_INTERVAL_HOURS=4
DB_ECHO=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Groq chat models (defaults match current Groq catalog; Llama 3.3 IDs were retired)
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# When AXON_INTERNAL_SECRET is set, FastAPI docs (/docs, /redoc, /openapi.json)
# stay private unless you explicitly opt in:
# EXPOSE_API_DOCS=true

# Web Push — frontend base URL the backend pings after a productive ingest.
# Must be set or new-signal notifications are silently skipped.
# Use the same AXON_INTERNAL_SECRET as the frontend.
AXON_FRONTEND_URL=https://axon-phi-ruby.vercel.app
